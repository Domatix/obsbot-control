{
    "app-id": "io.github.domatix.ObsbotCamControl",
    "runtime": "org.gnome.Platform",
    "runtime-version": "50",
    "sdk": "org.gnome.Sdk",
    "sdk-extensions": [
        "org.freedesktop.Sdk.Extension.rust-stable",
        "org.freedesktop.Sdk.Extension.llvm20"
    ],
    "command": "obsbot-cam-control",
    "finish-args": [
        "--share=ipc",
        "--socket=wayland",
        "--socket=fallback-x11",
        "--device=all",
        "--filesystem=xdg-pictures"
    ],
    "build-options": {
        "append-path": "/usr/lib/sdk/rust-stable/bin:/usr/lib/sdk/llvm20/bin",
        "prepend-ld-library-path": "/usr/lib/sdk/llvm20/lib",
        "build-args": [
            "--share=network"
        ],
        "env": {
            "CARGO_HOME": "/run/build/obsbot-cam-control/cargo",
            "LIBCLANG_PATH": "/usr/lib/sdk/llvm20/lib"
        }
    },
    "x-comment-sources": [
        "T-226: every git source carries a full commit next to its tag.",
        "A tag is a mutable ref in the source repository; the commit is",
        "what actually gets built. flatpak-builder verifies the tag",
        "resolves to that commit and fails the build otherwise.",
        "When bumping a version, update BOTH fields:",
        "  git ls-remote <url> refs/tags/<tag>"
    ],
    "x-comment-network": [
        "The two Rust modules still build with --share=network, so cargo",
        "resolves crates at build time and the build is not reproducible.",
        "Flathub does not accept this: it requires offline builds with the",
        "cargo sources declared and hashed, generated by",
        "flatpak-cargo-generator.py from flatpak-builder-tools.",
        "Tracked separately from T-226 because the generated manifest is a",
        "large file that only proves itself by building the Flatpak end to",
        "end, which the commit pins above do not need."
    ],
    "modules": [
        {
            "name": "blueprint-compiler",
            "buildsystem": "meson",
            "cleanup": [
                "*"
            ],
            "sources": [
                {
                    "type": "git",
                    "url": "https://gitlab.gnome.org/jwestman/blueprint-compiler.git",
                    "tag": "v0.16.0",
                    "commit": "be7beddc5201b1f5a5af517077dbc7c5390ecce1"
                }
            ]
        },
        {
            "name": "gst-plugin-gtk4",
            "buildsystem": "simple",
            "build-options": {
                "env": {
                    "CARGO_HOME": "/run/build/gst-plugin-gtk4/cargo"
                },
                "build-args": [
                    "--share=network"
                ]
            },
            "build-commands": [
                "cargo build --release -p gst-plugin-gtk4",
                "install -Dm644 target/release/libgstgtk4.so /app/lib/gstreamer-1.0/libgstgtk4.so"
            ],
            "sources": [
                {
                    "type": "git",
                    "url": "https://gitlab.freedesktop.org/gstreamer/gst-plugins-rs.git",
                    "tag": "0.13.5",
                    "commit": "4281db13b8bdf6272b2d47ecc9ecc2e056322275"
                }
            ]
        },
        {
            "name": "obsbot-cam-control",
            "buildsystem": "meson",
            "config-opts": [
                "--buildtype=release",
                "-Dlive-preview=true"
            ],
            "sources": [
                {
                    "type": "dir",
                    "path": ".."
                }
            ]
        }
    ]
}
