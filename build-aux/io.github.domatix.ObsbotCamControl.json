{
    "app-id": "io.github.domatix.ObsbotCamControl",
    "runtime": "org.gnome.Platform",
    "runtime-version": "50",
    "sdk": "org.gnome.Sdk",
    "sdk-extensions": [
        "org.freedesktop.Sdk.Extension.rust-stable",
        "org.freedesktop.Sdk.Extension.llvm20"
    ],
    "command": "obsbot-cam-control",
    "finish-args": [
        "--share=ipc",
        "--socket=wayland",
        "--socket=fallback-x11",
        "--device=all",
        "--filesystem=xdg-pictures"
    ],
    "build-options": {
        "append-path": "/usr/lib/sdk/rust-stable/bin:/usr/lib/sdk/llvm20/bin",
        "prepend-ld-library-path": "/usr/lib/sdk/llvm20/lib",
        "build-args": [
            "--share=network"
        ],
        "env": {
            "CARGO_HOME": "/run/build/obsbot-cam-control/cargo",
            "LIBCLANG_PATH": "/usr/lib/sdk/llvm20/lib"
        }
    },
    "modules": [
        {
            "name": "blueprint-compiler",
            "buildsystem": "meson",
            "cleanup": [
                "*"
            ],
            "sources": [
                {
                    "type": "git",
                    "url": "https://gitlab.gnome.org/jwestman/blueprint-compiler.git",
                    "tag": "v0.16.0"
                }
            ]
        },
        {
            "name": "gst-plugin-gtk4",
            "buildsystem": "simple",
            "build-options": {
                "env": {
                    "CARGO_HOME": "/run/build/gst-plugin-gtk4/cargo"
                },
                "build-args": [
                    "--share=network"
                ]
            },
            "build-commands": [
                "cargo build --release -p gst-plugin-gtk4",
                "install -Dm644 target/release/libgstgtk4.so /app/lib/gstreamer-1.0/libgstgtk4.so"
            ],
            "sources": [
                {
                    "type": "git",
                    "url": "https://gitlab.freedesktop.org/gstreamer/gst-plugins-rs.git",
                    "tag": "0.13.5"
                }
            ]
        },
        {
            "name": "obsbot-cam-control",
            "buildsystem": "meson",
            "config-opts": [
                "--buildtype=release",
                "-Dlive-preview=true"
            ],
            "sources": [
                {
                    "type": "dir",
                    "path": ".."
                }
            ]
        }
    ]
}
