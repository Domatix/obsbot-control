// SPDX-License-Identifier: GPL-3.0-or-later
//
// Static shell of the main window (T-099; restructured to a single
// page in T-220).
//
// T-220 collapsed the old Adw.NavigationView drill-down (a camera
// *list* root → a pushed controls page) into one page: the window now
// lands directly on the connected camera's config panel. The dynamic
// body (the per-camera controls built by `controls_view`, or the
// "no cameras" StatusPage) is mounted at runtime from `window.rs` into
// the `body_slot` Adw.Bin below; the per-camera AdwViewSwitcher and the
// optional camera-selector Gtk.DropDown are added to `header_bar` from
// code.
//
// IDs surfaced for `gtk::Builder::object(...)` lookups in code:
//   * window         — root Adw.ApplicationWindow (binds to the
//                      Adw.Application at startup).
//   * toast_overlay  — Adw.ToastOverlay wrapping the whole window
//                      (T-108 / T-110). Both V4L2-write-failure
//                      toasts (T-108) and hot-plug REMOVE
//                      notifications (T-110) land here; the
//                      window-level placement means toasts survive a
//                      body re-mount (e.g. a camera switch).
//   * header_bar     — Adw.HeaderBar of the single page. Carries the
//                      hamburger MenuButton at [end]; code packs the
//                      camera Gtk.DropDown at [start] (visible only
//                      with >1 camera) and sets the AdwViewSwitcher as
//                      its title widget (T-220).
//   * body_slot      — Adw.Bin filled with the dynamic body
//                      (the per-camera controls widget, or a
//                      StatusPage if the enumeration is empty). The
//                      hot-plug poll replaces the bin's child when the
//                      enumeration changes.

using Gtk 4.0;
using Adw 1;

// Primary menu (T-106). Two items for now — "About" opens the
// AdwAboutDialog registered in `application::register_actions`,
// "Quit" reuses the same `app.quit` action wired to Ctrl+Q.
menu primary_menu {
  section {
    label: _("Appearance");

    item {
      label: _("Follow system");
      action: "app.color-scheme";
      target: "default";
    }

    item {
      label: _("Light");
      action: "app.color-scheme";
      target: "light";
    }

    item {
      label: _("Dark");
      action: "app.color-scheme";
      target: "dark";
    }
  }

  section {
    item {
      label: _("About Obsbot Cam Control");
      action: "app.about";
    }
    item {
      label: _("Quit");
      action: "app.quit";
    }
  }
}

Adw.ApplicationWindow window {
  title: "Obsbot Cam Control";
  // T-213: roomier default so the preview card and the controls below
  // it both get comfortable space (the old 720×540 squeezed the tabs
  // once the preview card was on screen).
  default-width: 920;
  default-height: 800;
  width-request: 360;
  height-request: 480;

  content: Adw.ToastOverlay toast_overlay {
    Adw.ToolbarView {
      [top]
      Adw.HeaderBar header_bar {
        [end]
        Gtk.MenuButton {
          icon-name: "open-menu-symbolic";
          menu-model: primary_menu;
          tooltip-text: _("Main Menu");
          primary: true;
        }
      }

      content: Adw.Bin body_slot {
        vexpand: true;
      };
    }
  };
}
